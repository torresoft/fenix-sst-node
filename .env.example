NODE_ENV=development
PORT=3000
HOST=127.0.0.1
TZ=America/Bogota

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=fenix_app
DB_PASSWORD=
DB_NAME=fenix_sst

# Minimo 32 caracteres en produccion
SESSION_SECRET=
SESSION_HORAS=8

# Region de alojamiento de datos por defecto para tenants nuevos
REGION_DATOS=co-bogota

# URL publica (enlaces en los correos)
APP_URL=http://localhost:3000

# SMTP. Sin SMTP_HOST los correos se registran como omitidos.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fenix SST <no-responder@dominio.co>"

# Archivos del gestor documental (fuera de public/). Tamano maximo en MB.
ALMACEN_DIR=./almacen
ARCHIVO_MAX_MB=20
EXPEDIENTE_MAX_MB=1024
PSICOSOCIAL_MIN_GRUPO=5

# Suscripciones. Gracia vacia = nunca suspender automaticamente al vencer.
SUSCRIPCION_DIAS_GRACIA=
SUSCRIPCION_AVISOS=15,5,1
SUSCRIPCION_VENTANA=30
