<nav class="main-header navbar navbar-expand navbar-white navbar-light">
  <ul class="navbar-nav">
    <li class="nav-item">
      <a class="nav-link" data-widget="pushmenu" href="#" role="button" title="Men&uacute;"><i class="fas fa-bars"></i></a>
    </li>
  </ul>

  <ul class="navbar-nav ml-auto">
    <% if (accesos.length > 1 || (accesos.length === 1 && !empresaActiva)) { %>
    <li class="nav-item dropdown">
      <a class="nav-link" data-toggle="dropdown" href="#" title="Cambiar empresa activa">
        <i class="fas fa-building mr-1"></i>
        <span class="d-none d-md-inline"><%= empresaActiva ? empresaActiva.razonSocial : 'Seleccionar empresa' %></span>
        <i class="fas fa-caret-down ml-1"></i>
      </a>
      <div class="dropdown-menu dropdown-menu-right dropdown-menu-lg">
        <form method="post" action="/empresa-activa">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <span class="dropdown-header">Empresas</span>
          <% accesos.forEach(function (a) { %>
          <button type="submit" name="empresa_id" value="<%= a.empresaId %>"
                  class="dropdown-item<%= empresaActiva && empresaActiva.id === a.empresaId ? ' active' : '' %>">
            <%= a.razonSocial %> <small class="text-muted">NIT <%= a.nit %></small>
          </button>
          <% }) %>
        </form>
      </div>
    </li>
    <% } else if (empresaActiva) { %>
    <li class="nav-item">
      <span class="nav-link"><i class="fas fa-building mr-1"></i><%= empresaActiva.razonSocial %></span>
    </li>
    <% } %>

    <li class="nav-item dropdown">
      <a class="nav-link" data-toggle="dropdown" href="#" title="Cuenta">
        <i class="fas fa-user-circle"></i>
        <span class="d-none d-md-inline ml-1"><%= usuario.nombre %></span>
      </a>
      <div class="dropdown-menu dropdown-menu-right">
        <span class="dropdown-header"><%= usuario.email %></span>
        <a href="/cambiar-password" class="dropdown-item"><i class="fas fa-key mr-2"></i>Cambiar contrase&ntilde;a</a>
        <div class="dropdown-divider"></div>
        <form method="post" action="/logout" data-turbo="false">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt mr-2"></i>Cerrar sesi&oacute;n</button>
        </form>
      </div>
    </li>
  </ul>
</nav>
