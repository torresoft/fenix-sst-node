<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= textoPlano(titulo) %> | Fénix SST</title>
<%- include('partials/recursos') %>
</head>
<body class="hold-transition login-page login-fondo">
<div class="login-box">
  <div class="card card-outline card-danger">
    <div class="card-body">
      <h3 class="text-danger"><i class="fas fa-exclamation-triangle mr-2"></i><%= status %></h3>
      <p class="mb-3"><% if (locals.mensajeHtml) { %><%- mensajeHtml %><% } else { %><%= mensaje %><% } %></p>
      <a href="/" class="btn btn-sm btn-default"><i class="fas fa-home mr-1"></i>Ir al inicio</a>
    </div>
  </div>
</div>
</body>
</html>
