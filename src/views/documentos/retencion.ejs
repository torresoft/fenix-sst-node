<%- include('../partials/cabecera') %>
<div class="row">
  <div class="col-lg-8">
    <div class="card card-outline card-primary">
      <div class="card-header"><h3 class="card-title">A&ntilde;os de conservaci&oacute;n por tipo documental</h3></div>
      <form method="post" action="/documentos/retencion">
        <div class="card-body p-0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <p class="small text-muted p-3 mb-0">
            Los 5 tipos del art. 2.2.4.6.13 se conservan 20 a&ntilde;os desde el retiro de la persona y no se configuran aqu&iacute;.
            Para los dem&aacute;s la norma remite a la tabla de retenci&oacute;n de la empresa: los a&ntilde;os cuentan desde que el documento
            deja de estar vigente (reemplazado o anulado).
          </p>
          <table class="table table-bordered table-hover table-sm mb-0">
            <thead><tr><th>Tipo documental</th><th class="w-25">A&ntilde;os</th></tr></thead>
            <tbody>
              <% filas.forEach(function (f) { %>
              <tr>
                <td><%= f.nombre %></td>
                <td><input type="number" name="r_<%= f.codigo %>" class="form-control form-control-sm" min="1" max="100" value="<%= f.anios || '' %>" <%= gestionar ? '' : 'disabled' %> placeholder="Sin definir"></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="card-footer">
          <a href="/documentos" class="btn btn-default">Volver</a>
          <% if (gestionar) { %><button type="submit" class="btn btn-primary float-right"><i class="fas fa-save mr-1"></i>Guardar</button><% } %>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/pie') %>
